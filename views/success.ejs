<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submission Successful</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <div class="success-container">
      <div class="success-icon">✓</div>
      <h1>Submission Successful!</h1>
      <p class="subtitle">Your information has been received and validated</p>

      <div class="success-details">
        <div class="detail-row">
          <span class="detail-label">Full Name:</span>
          <span class="detail-value"><%= data.fullName %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Email Address:</span>
          <span class="detail-value"><%= data.email %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Age:</span>
          <span class="detail-value"><%= data.age %> years old</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Phone Number:</span>
          <span class="detail-value"><%= data.phone %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Biography:</span>
          <span class="detail-value">
            <% if (data.biography !== 'Not provided') { %>
              <%= data.biography %>
            <% } else { %>
              <em>Not provided</em>
            <% } %>
          </span>
        </div>
      </div>

      <p style="color: #555; font-size: 14px; margin-bottom: 24px;">
        Thank you for submitting your information. In a real application, this data would be processed or stored in a database.
      </p>

      <a href="/" class="btn btn-primary">Submit Another Form</a>
    </div>
  </div>
</body>
</html>
